SERVER_HOSTNAME=radio.yourfamily.com
STATION_NAME="Your Family Radio"
STATION_DESCRIPTION="Our family radio station"
ICECAST_SOURCE_PASSWORD=changeme_source
ICECAST_ADMIN_PASSWORD=changeme_admin
ICECAST_RELAY_PASSWORD=changeme_relay
ADMIN_TOKEN=changeme_admin_token

# Backup (optional — leave unset to disable)
# S3 and any S3-compatible store (Cloudflare R2, Backblaze B2, Wasabi, etc.) are supported.
# BACKUP_DEST=s3://your-bucket-name
# BACKUP_ENDPOINT_URL=https://endpoint.example.com  # only needed for non-AWS S3-compatible stores

# Push notifications via Web Push / VAPID (optional — leave unset to disable)
# See README § Push Notifications for key generation instructions.
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=admin@yourfamily.com

# Public stream URL for smart home speakers, smart TVs, and Chromecast (optional — leave unset to disable)
# Use 3 memorable words separated by hyphens. Share this URL instead of the main site URL.
# URL will be: https://YOUR_DOMAIN/stream-WORD1-WORD2-WORD3
# Also enables the Cast button on the Now Playing page to route audio through this URL.
# PUBLIC_STREAM_TOKEN=word1-word2-word3

# CloudWatch listener count metrics (optional — leave unset to disable)
# See README § CloudWatch Metrics for setup instructions.
# AWS_DEFAULT_REGION=us-west-2

# AI DJ interludes (optional — leave unset to disable)
# See README § AI DJ for setup instructions. Enable in the admin panel after adding the key.
# GOOGLE_API_KEY=your-gemini-api-key

# Email (optional — leave unset to disable all emails)
# Supports any SMTP provider. Resend (resend.com) is recommended.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
# ALERT_FROM=noreply@yourdomain.com
# ALERT_TO=your-alert-recipient@example.com
